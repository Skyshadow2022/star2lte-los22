Subject: [PATCH] libhwjpeg: don't fail JPEG encode on inconsistent Exif dimensions

diff --git a/base/libhwjpeg/ExynosJpegEncoderForCamera.cpp b/base/libhwjpeg/ExynosJpegEncoderForCamera.cpp
--- a/base/libhwjpeg/ExynosJpegEncoderForCamera.cpp
+++ b/base/libhwjpeg/ExynosJpegEncoderForCamera.cpp
@@ -243,18 +243,34 @@ bool ExynosJpegEncoderForCamera::ProcessExif(char *base, size_t limit,
     getSize(reinterpret_cast<int *>(&width), reinterpret_cast<int *>(&height));
 
     if (exifInfo) {
+        // star2lte fix: the proprietary libexynoscamera3 blob (from an older
+        // Samsung firmware) hands us an exif_attribute_t whose image/thumbnail
+        // dimensions do not match the size configured on the encoder. The
+        // original code aborts the whole capture in that case, which makes
+        // photo saving fail while video keeps working. The encoder already
+        // knows the correct geometry from setSize()/setThumbnailSize(), so we
+        // correct the Exif fields instead of failing the encode.
         if ((exifInfo->width != width) || (exifInfo->height != height)) {
-            ALOGE("Inconsistant image dimension: Exif %dx%d, Thumb %dx%d",
+            ALOGW("Correcting inconsistent Exif image dimension: Exif %dx%d -> %dx%d",
                     exifInfo->width, exifInfo->height, width, height);
-            return false;
+            exifInfo->width = width;
+            exifInfo->height = height;
         }
 
         if (exifInfo->enableThumb) {
             if ((exifInfo->widthThumb != static_cast<uint32_t>(m_nThumbWidth)) ||
                     (exifInfo->heightThumb != static_cast<uint32_t>(m_nThumbHeight))) {
-                ALOGE("Inconsistant thumbnail information: Exif %dx%d, Thumb %dx%d",
-                        exifInfo->widthThumb, exifInfo->heightThumb, m_nThumbWidth, m_nThumbHeight);
-                return false;
+                if ((m_nThumbWidth >= 16) && (m_nThumbHeight >= 16)) {
+                    ALOGW("Correcting inconsistent Exif thumbnail: Exif %dx%d -> %dx%d",
+                            exifInfo->widthThumb, exifInfo->heightThumb,
+                            m_nThumbWidth, m_nThumbHeight);
+                    exifInfo->widthThumb = static_cast<uint32_t>(m_nThumbWidth);
+                    exifInfo->heightThumb = static_cast<uint32_t>(m_nThumbHeight);
+                } else {
+                    ALOGW("Disabling Exif thumbnail due to invalid size %dx%d",
+                            m_nThumbWidth, m_nThumbHeight);
+                    exifInfo->enableThumb = false;
+                }
             }
         }
     }
